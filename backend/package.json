{
  "name": "@api-hourtracker/backend",
  "version": "1.0.0",
  "description": "A barebones API allowing users to track time spent doing any activity they want.",
  "license": "ISC",
  "author": "Nick Mills",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "nodemon --watch ./src/server.ts --watch src/routes --watch src/controllers --ext js,ts,json --exec tsx ./src/server.ts",
    "db:reset": "prisma migrate reset --force",
    "db:rebuild": "prisma migrate reset --force && prisma generate",
    "db:seed": "prisma db seed",
    "docker:pause": "docker compose -f ../docker/docker-compose.yml stop",
    "docker:resume": "docker compose -f ../docker/docker-compose.yml start",
    "docker:stop": "docker compose -f ../docker/docker-compose.yml down",
    "docker:start": "docker compose -f ../docker/docker-compose.yml up -d",
    "docker:restart": "npm run docker:stop && npm run docker:start"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "prisma": "^7.8.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@prisma/client": "^7.8.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "nodemon": "^3.1.14"
  }
}
