generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id          Int             @id @default(autoincrement())
  name        String
  email       String          @unique

  activities  UserActivity[]
  entries     TimeEntry[]
}

model Activity {
  id          Int             @id @default(autoincrement())
  name        String          @unique

  users       UserActivity[]
  entries     TimeEntry[]
}

model UserActivity {
  userId      Int
  activityId  Int

  user        User            @relation(fields: [userId], references: [id])
  activity    Activity        @relation(fields: [activityId], references: [id])

  @@id([userId, activityId])
}

model TimeEntry {
  id          Int             @id @default(autoincrement())

  startTime   DateTime
  endTime     DateTime?
  duration    Int?

  userId      Int
  activityId  Int

  user        User            @relation(fields: [userId], references: [id])
  activity    Activity        @relation(fields: [activityId], references: [id])
}